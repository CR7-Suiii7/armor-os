# /etc/pam.d/common-auth - Customized for ARMOR OS Key-Based Authentication Only
# Disables all standard password authentication; mandates hardware key challenge-response.

auth	requisite			pam_exec.so quiet /usr/local/bin/armor-pam-auth.sh
auth	[success=1 default=ignore]	pam_unix.so nullok_secure try_first_pass
auth	requisite			pam_deny.so
auth	required			pam_permit.so
