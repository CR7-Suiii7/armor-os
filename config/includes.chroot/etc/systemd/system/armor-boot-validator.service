[Unit]
Description=ARMOR Boot Integrity and Hardware Key Validator
DefaultDependencies=no
After=systemd-udev-settle.service local-fs.target
Before=display-manager.service lightdm.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/armor-boot-validator
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=sysinit.target
